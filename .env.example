# =====================================================================
# Jarvis 3.0 — variables d'environnement
# Copier ce fichier vers .env puis remplir.
# =====================================================================

# --- Réseau ---
JARVIS_DOMAIN=jarvis.local
JARVIS_HTTP_PORT=80
JARVIS_HTTPS_PORT=443

# --- Auth / JWT ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
OWNER_USERNAME=mickael

# --- Base Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change_me

# --- Redis (bus interne) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Qdrant (mémoire vectorielle) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=conversations

# --- MQTT (IoT) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=jarvis
MQTT_PASSWORD=change_me

# --- LLM provider (default) ---
# Valeurs possibles: ollama | anthropic | mistral
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Ollama local
OLLAMA_HOST=http://ollama:11434

# Anthropic Claude (cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mistral (cloud)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# OpenRouter (gateway unique vers 200+ modèles : Claude, GPT, Llama, Gemini…)
# Récupère ta clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
OPENROUTER_HTTP_REFERER=https://jarvis.local
OPENROUTER_APP_NAME=Jarvis 3.0

# --- TTS provider ---
# Valeurs possibles: piper | elevenlabs
TTS_PROVIDER=piper
PIPER_VOICE=fr_FR-siwis-medium
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- STT ---
WHISPER_MODEL=small
WHISPER_LANG=fr
WHISPER_DEVICE=cpu  # cpu | cuda
WHISPER_COMPUTE_TYPE=int8  # int8 | float16

# --- Voix-print ---
VOICEPRINT_THRESHOLD_ACCEPT=0.75
VOICEPRINT_THRESHOLD_GREY=0.65
VOICEPRINT_CHALLENGE_ENABLED=true
ADMIN_COMMAND_COOLDOWN_SECONDS=30

# --- Liveness AASIST (anti-deepfake voix) ---
# Place le modèle ONNX dans /models/aasist/aasist.onnx
LIVENESS_THRESHOLD=0.5
AASIST_MODEL_PATH=/models/aasist/aasist.onnx

# --- STT streaming partial transcripts ---
STT_PARTIAL_EVERY_MS=700

# --- Home Assistant ---
HA_BASE_URL=http://homeassistant:8123
HA_LONG_LIVED_TOKEN=

# --- Argus (sécurité réseau) ---
ARGUS_WS_URL=wss://argus.local/ws/alerts
ARGUS_API_TOKEN=

# --- Vision / Frigate ---
FRIGATE_WS_URL=ws://frigate:5000/ws
FRIGATE_API_URL=http://frigate:5000
FRIGATE_RTSP_PASSWORD=
FACE_THRESHOLD=0.45
KNOWN_FACES_DIR=/models/known_faces

# --- Arduino série ---
ARDUINO_SERIAL_PORTS=/dev/ttyUSB0,/dev/ttyACM0
ARDUINO_BAUDRATE=115200

# --- Zigbee2MQTT ---
Z2M_BASE_TOPIC=zigbee2mqtt
Z2M_FRONTEND_URL=http://zigbee2mqtt:8080
TZ=Europe/Paris

# --- Wake-word ---
WAKE_WORD=jarvis
WAKE_WORD_THRESHOLD=0.6

# --- LLM streaming → TTS phrase-par-phrase ---
LLM_STREAM_ENABLED=true

# --- Web Push (VAPID) — générer une fois :
#   docker run --rm node:20 npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- Briefing matinal ---
BRIEFING_CITY=Paris
CALDAV_URL=
CALDAV_USER=
CALDAV_PASS=

# --- Memory (RAG souvenirs) ---
EMBED_MODEL=BAAI/bge-m3
EMBED_CACHE_SIZE=256
# Poids du scoring composite (somme ~ 1.0)
MEM_W_SIM=0.55
MEM_W_REC=0.20
MEM_W_IMP=0.15
MEM_W_USE=0.10
MEM_HALF_LIFE_DAYS=90
MEM_MAX_RECALLS=20

# RAG côté orchestrator
RAG_TOP_K=4
RAG_MIN_SCORE=0.55
RAG_TIMEOUT_S=1.5

# --- Learning (routines apprises) ---
LEARN_PATTERN_MIN_SAMPLES=5
LEARN_PATTERN_MIN_DAYS=3
LEARN_INTERVAL_S=3600
PRESENCE_SIM_INTERVAL_S=1800

# --- Agents externes (Hermes / OpenClaw / MCP) ---
# Build args : true pour installer les binaires dans l'image
INSTALL_HERMES=false
INSTALL_OPENCLAW=false
# Commandes (override si tes binaires sont à un autre path)
AGENT_HERMES_CMD=hermes
AGENT_HERMES_TIMEOUT_S=600
AGENT_OPENCLAW_CMD=openclaw chat -
AGENT_OPENCLAW_TIMEOUT_S=600
# Pour activer le transport MCP (alternative au CLI)
AGENT_HERMES_MCP=
AGENT_OPENCLAW_MCP=
# Mock adapter (pour tests offline) — désactiver en prod
AGENTS_ENABLE_MOCK=true

# --- Monitoring (docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_PASSWORD=changeme

# --- Deepfake / face anti-spoofing ---
DEEPFAKE_THRESHOLD=0.5
DEEPFAKE_BLOCK_ON_MISS=false
DEEPFAKE_MODEL_PATH=/models/anti_spoof/minifasnet.onnx

# --- Fédération multi-instances ---
FEDERATION_INSTANCE_ID=
FEDERATION_LABEL=primary
FEDERATION_PEERS=
FEDERATION_HEARTBEAT_S=30
